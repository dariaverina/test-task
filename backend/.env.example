APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shortlinks_database
DB_USERNAME=root
DB_PASSWORD=root

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

VITE_APP_NAME="${APP_NAME}"